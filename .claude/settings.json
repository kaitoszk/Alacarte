{
  "permissions": {
    "allow": [
      "Bash(docker compose exec app php artisan test:*)",
      "Bash(docker compose exec app ./vendor/bin/pint:*)",
      "Bash(docker compose ps:*)",
      "Bash(npm run build:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm run format:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git switch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(ls:*)",
      "Bash(cat:*)"
    ],
    "deny": [
      "Bash(docker compose exec app php artisan migrate:fresh:*)",
      "Bash(docker compose down -v:*)",
      "Bash(git push --force:*)",
      "Bash(git push * main)",
      "Bash(git push * HEAD:main)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh repo delete:*)",
      "Bash(cat *.env*)",
      "Bash(rm -rf:*)",
      "Read(./.env)"
    ]
  }
}